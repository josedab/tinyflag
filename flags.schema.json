{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TinyFlag Configuration",
  "description": "Schema for TinyFlag feature flag definition files",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1],
      "description": "Schema version. Currently only version 1 is supported."
    },
    "flags": {
      "type": "object",
      "description": "Map of flag names to their definitions.",
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$": {
          "$ref": "#/definitions/FlagDefinition"
        }
      },
      "additionalProperties": false
    },
    "personas": {
      "type": "object",
      "description": "Named context presets (personas) for flag evaluation.",
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$": {
          "type": "object",
          "description": "Context key-value pairs for this persona.",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "segments": {
      "type": "object",
      "description": "Named segments defining reusable targeting conditions.",
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$": {
          "$ref": "#/definitions/Segment"
        }
      },
      "additionalProperties": false
    },
    "tenants": {
      "type": "object",
      "description": "Tenant-scoped flag overrides for multi-tenant isolation.",
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "flags": {
              "type": "object",
              "description": "Tenant-specific flag overrides merged on top of global defaults.",
              "additionalProperties": true
            }
          },
          "required": ["flags"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["flags"],
  "definitions": {
    "FlagDefinition": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether this flag is globally enabled."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the flag."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Categorization tags."
        },
        "rollout": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of users to enable for (0-100)."
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/definitions/Rule" },
          "description": "Targeting rules evaluated top-to-bottom."
        },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/definitions/Variant" },
          "description": "A/B test variants with relative weights."
        },
        "schedule": {
          "$ref": "#/definitions/Schedule",
          "description": "Scheduled enable/disable times (ISO 8601 with timezone offset)."
        },
        "requires": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Prerequisite flag names that must be enabled."
        },
        "lifecycle": {
          "$ref": "#/definitions/Lifecycle",
          "description": "Flag lifecycle state metadata."
        },
        "config": {
          "type": "object",
          "description": "Typed configuration values associated with this flag.",
          "additionalProperties": true
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "Rule": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "object",
          "description": "Key-value conditions on UserContext. All must match (AND logic)."
        },
        "enabled": {
          "type": "boolean",
          "description": "Override enabled state when rule matches."
        },
        "rollout": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Override rollout percentage when rule matches."
        },
        "variant": {
          "type": "string",
          "description": "Force a specific variant when rule matches."
        },
        "segment": {
          "type": "string",
          "description": "Reference a named segment instead of inline conditions."
        }
      },
      "required": ["conditions"]
    },
    "Variant": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Variant identifier."
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "description": "Relative weight for distribution."
        }
      },
      "required": ["name", "weight"]
    },
    "Schedule": {
      "type": "object",
      "properties": {
        "enableAt": {
          "type": "string",
          "description": "ISO 8601 datetime with timezone offset when the flag should be enabled."
        },
        "disableAt": {
          "type": "string",
          "description": "ISO 8601 datetime with timezone offset when the flag should be disabled."
        }
      },
      "additionalProperties": false
    },
    "Lifecycle": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": ["draft", "active", "sunset", "archived"],
          "description": "Current lifecycle state of the flag."
        },
        "sunsetAt": {
          "type": "string",
          "description": "ISO 8601 datetime when sunset begins. Required when state is 'sunset'."
        }
      },
      "required": ["state"],
      "additionalProperties": false
    },
    "Segment": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "object",
          "description": "Conditions that define segment membership."
        },
        "extends": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Other segments this segment inherits conditions from."
        }
      },
      "required": ["conditions"],
      "additionalProperties": false
    }
  }
}
