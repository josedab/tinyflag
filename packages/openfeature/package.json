{
  "name": "tinyflag-openfeature",
  "version": "0.1.0",
  "description": "OpenFeature provider for TinyFlag feature flag SDK",
  "license": "MIT",
  "author": "josedab",
  "repository": {
    "type": "git",
    "url": "https://github.com/josedab/tinyflag.git",
    "directory": "packages/openfeature"
  },
  "homepage": "https://github.com/josedab/tinyflag#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "feature-flags",
    "openfeature",
    "provider",
    "tinyflag"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "tinyflag": "workspace:*"
  },
  "dependencies": {
    "@openfeature/server-sdk": "^1.15.0"
  },
  "devDependencies": {
    "tinyflag": "workspace:*",
    "@openfeature/server-sdk": "^1.15.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
