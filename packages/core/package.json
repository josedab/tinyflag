{
  "name": "tinyflag",
  "version": "0.1.0",
  "description": "Serverless, file-driven, zero-dependency feature flag SDK for JavaScript/TypeScript",
  "license": "MIT",
  "author": "josedab",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/josedab/tinyflag.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/josedab/tinyflag#readme",
  "bugs": {
    "url": "https://github.com/josedab/tinyflag/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      }
    },
    "./signing": {
      "import": {
        "types": "./dist/signing.d.ts",
        "default": "./dist/signing.js"
      },
      "require": {
        "types": "./dist/signing.d.cts",
        "default": "./dist/signing.cjs"
      }
    },
    "./sync": {
      "import": {
        "types": "./dist/sync.d.ts",
        "default": "./dist/sync.js"
      },
      "require": {
        "types": "./dist/sync.d.cts",
        "default": "./dist/sync.cjs"
      }
    },
    "./progressive": {
      "import": {
        "types": "./dist/progressive.d.ts",
        "default": "./dist/progressive.js"
      },
      "require": {
        "types": "./dist/progressive.d.cts",
        "default": "./dist/progressive.cjs"
      }
    },
    "./correlation": {
      "import": {
        "types": "./dist/correlation.d.ts",
        "default": "./dist/correlation.js"
      },
      "require": {
        "types": "./dist/correlation.d.cts",
        "default": "./dist/correlation.cjs"
      }
    },
    "./governance": {
      "import": {
        "types": "./dist/governance.d.ts",
        "default": "./dist/governance.js"
      },
      "require": {
        "types": "./dist/governance.d.cts",
        "default": "./dist/governance.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "a-b-testing",
    "rollout",
    "flags-as-code",
    "yaml",
    "serverless",
    "edge",
    "zero-dependency"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle.mjs",
    "dev": "vitest --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
