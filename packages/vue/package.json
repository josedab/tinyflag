{
  "name": "tinyflag-vue",
  "version": "0.1.0",
  "description": "Vue composables for TinyFlag feature flags",
  "license": "MIT",
  "author": "josedab",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "vue",
    "vue-composables",
    "a-b-testing",
    "rollout",
    "flags-as-code"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/josedab/tinyflag.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/josedab/tinyflag#readme",
  "bugs": {
    "url": "https://github.com/josedab/tinyflag/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "dev": "vitest --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "tinyflag": "workspace:*",
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^30.0.0",
    "tinyflag": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0"
  }
}
