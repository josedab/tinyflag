{
  "name": "tinyflag-react",
  "version": "0.1.0",
  "description": "React hooks for TinyFlag feature flags",
  "license": "MIT",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "react",
    "react-hooks",
    "a-b-testing",
    "rollout",
    "flags-as-code"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/josedab/tinyflag.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/josedab/tinyflag#readme",
  "bugs": {
    "url": "https://github.com/josedab/tinyflag/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "dev": "vitest --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "tinyflag": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tinyflag": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
