{
  "name": "tinyflag-cli",
  "version": "0.1.0",
  "description": "CLI tools for TinyFlag feature flag SDK",
  "license": "MIT",
  "keywords": [
    "feature-flags",
    "cli",
    "yaml",
    "validation",
    "typescript-codegen",
    "flags-as-code"
  ],
  "author": "josedab",
  "repository": {
    "type": "git",
    "url": "https://github.com/josedab/tinyflag.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/josedab/tinyflag#readme",
  "bugs": {
    "url": "https://github.com/josedab/tinyflag/issues"
  },
  "type": "module",
  "bin": {
    "tinyflag": "./dist/index.js"
  },
  "exports": {
    "./lib": {
      "import": {
        "types": "./dist/lib.d.ts",
        "default": "./dist/lib.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "dev": "vitest --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "tinyflag": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
